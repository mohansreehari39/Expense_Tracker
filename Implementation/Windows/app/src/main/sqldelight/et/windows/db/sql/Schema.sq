upsertTripParticipant:
INSERT OR REPLACE INTO tripParticipant (id, tripId, displayName, memberId, isArchived, deviceId, updatedAt, isDeleted, serverSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTripParticipants:
