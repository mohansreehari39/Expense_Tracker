-- Two-tier schema per Design/Core/03-sync-protocol.md and
-- Design/Windows/02-transport-implementation.md: an append-only operation
-- log (the sync substrate) plus read-optimized materialized tables that
-- the repository keeps in sync with it. v0 has no peer sync wired up yet,
-- so the log is currently written-but-not-yet-transmitted — it's here so
-- adding real sync later doesn't require a schema migration.

CREATE TABLE operationLog (
    opId TEXT NOT NULL PRIMARY KEY,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    opType TEXT NOT NULL,
    patchJson TEXT NOT NULL,
    authorDeviceId TEXT NOT NULL,
    hlcPhysical INTEGER NOT NULL,
    hlcCounter INTEGER NOT NULL,
    receivedFrom TEXT
);

CREATE INDEX operationLog_frontier ON operationLog(authorDeviceId, hlcPhysical, hlcCounter);

insertOperation:
INSERT OR IGNORE INTO operationLog (opId, entityType, entityId, opType, patchJson, authorDeviceId, hlcPhysical, hlcCounter, receivedFrom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

allOperations:
SELECT * FROM operationLog;

-- Materialized tables --------------------------------------------------

CREATE TABLE household (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    defaultBudgetAmountMinorUnits INTEGER,
    defaultBudgetCurrency TEXT,
    settlementEnabled INTEGER NOT NULL DEFAULT 0
);

upsertHousehold:
INSERT OR REPLACE INTO household (id, name, createdAt, defaultBudgetAmountMinorUnits, defaultBudgetCurrency, settlementEnabled)
VALUES (?, ?, ?, ?, ?, ?);

selectHouseholds:
SELECT * FROM household ORDER BY createdAt;

selectHouseholdById:
SELECT * FROM household WHERE id = ?;

CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0
);

upsertCategory:
INSERT OR REPLACE INTO category (id, householdId, name, icon, isArchived) VALUES (?, ?, ?, ?, ?);

selectCategories:
SELECT * FROM category WHERE householdId = ? AND isArchived = 0;

selectCategoryById:
SELECT * FROM category WHERE id = ?;

CREATE TABLE subcategory (
    id TEXT NOT NULL PRIMARY KEY,
    categoryId TEXT NOT NULL,
    name TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0
);

upsertSubcategory:
INSERT OR REPLACE INTO subcategory (id, categoryId, name, isArchived) VALUES (?, ?, ?, ?);

selectSubcategories:
SELECT * FROM subcategory WHERE categoryId = ? AND isArchived = 0;

selectSubcategoryById:
SELECT * FROM subcategory WHERE id = ?;

CREATE TABLE member (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    displayName TEXT NOT NULL,
    deviceId TEXT,
    isArchived INTEGER NOT NULL DEFAULT 0
);

upsertMember:
INSERT OR REPLACE INTO member (id, householdId, displayName, deviceId, isArchived) VALUES (?, ?, ?, ?, ?);

selectMembers:
SELECT * FROM member WHERE householdId = ? AND isArchived = 0;

selectMemberById:
SELECT * FROM member WHERE id = ?;

CREATE TABLE householdDependent (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0
);

upsertHouseholdDependent:
INSERT OR REPLACE INTO householdDependent (id, householdId, name, category, isArchived) VALUES (?, ?, ?, ?, ?);

selectHouseholdDependents:
SELECT * FROM householdDependent WHERE householdId = ? AND isArchived = 0;

selectHouseholdDependentById:
SELECT * FROM householdDependent WHERE id = ?;

CREATE TABLE monthlyBudget (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    year INTEGER NOT NULL,
    month INTEGER NOT NULL,
    totalAmountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    perCategoryJson TEXT NOT NULL,
    UNIQUE(householdId, year, month)
);

upsertMonthlyBudget:
INSERT OR REPLACE INTO monthlyBudget (id, householdId, year, month, totalAmountMinorUnits, currency, perCategoryJson)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectMonthlyBudget:
SELECT * FROM monthlyBudget WHERE householdId = ? AND year = ? AND month = ?;

CREATE TABLE householdExpense (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    categoryId TEXT NOT NULL,
    subcategoryId TEXT,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    paidByMemberId TEXT NOT NULL,
    occurredAt INTEGER NOT NULL,
    note TEXT NOT NULL,
    createdByDeviceId TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE INDEX householdExpense_occurredAt ON householdExpense(householdId, occurredAt);

insertHouseholdExpense:
INSERT INTO householdExpense (id, householdId, categoryId, subcategoryId, amountMinorUnits, currency, paidByMemberId, occurredAt, note, createdByDeviceId, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholdExpensesBetween:
SELECT * FROM householdExpense WHERE householdId = ? AND occurredAt >= ? AND occurredAt < ? ORDER BY occurredAt DESC;

selectHouseholdExpenseById:
SELECT * FROM householdExpense WHERE id = ?;

updateHouseholdExpense:
UPDATE householdExpense SET categoryId = ?, subcategoryId = ?, amountMinorUnits = ?, currency = ?, paidByMemberId = ?, occurredAt = ?, note = ? WHERE id = ?;

deleteHouseholdExpense:
DELETE FROM householdExpense WHERE id = ?;

CREATE TABLE householdExpenseBeneficiary (
    id TEXT NOT NULL PRIMARY KEY,
    householdExpenseId TEXT NOT NULL,
    memberId TEXT,
    dependentId TEXT,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertHouseholdExpenseBeneficiary:
INSERT INTO householdExpenseBeneficiary (id, householdExpenseId, memberId, dependentId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?, ?);

selectHouseholdExpenseBeneficiaries:
SELECT * FROM householdExpenseBeneficiary WHERE householdExpenseId = ?;

deleteHouseholdExpenseBeneficiariesForExpense:
DELETE FROM householdExpenseBeneficiary WHERE householdExpenseId = ?;

CREATE TABLE householdExpenseContribution (
    id TEXT NOT NULL PRIMARY KEY,
    householdExpenseId TEXT NOT NULL,
    memberId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertHouseholdExpenseContribution:
INSERT INTO householdExpenseContribution (id, householdExpenseId, memberId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectHouseholdExpenseContributions:
SELECT * FROM householdExpenseContribution WHERE householdExpenseId = ?;

deleteHouseholdExpenseContributionsForExpense:
DELETE FROM householdExpenseContribution WHERE householdExpenseId = ?;

CREATE TABLE trip (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    startDate INTEGER NOT NULL,
    endDate INTEGER,
    budgetAmountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    createdBy TEXT NOT NULL,
    isClosed INTEGER NOT NULL DEFAULT 0
);

upsertTrip:
INSERT OR REPLACE INTO trip (id, name, startDate, endDate, budgetAmountMinorUnits, currency, createdBy, isClosed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectTrips:
SELECT * FROM trip ORDER BY startDate DESC;

selectTrip:
SELECT * FROM trip WHERE id = ?;

CREATE TABLE tripParticipant (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    displayName TEXT NOT NULL,
    memberId TEXT,
    isArchived INTEGER NOT NULL DEFAULT 0
);

upsertTripParticipant:
INSERT OR REPLACE INTO tripParticipant (id, tripId, displayName, memberId, isArchived) VALUES (?, ?, ?, ?, ?);

selectTripParticipants:
SELECT * FROM tripParticipant WHERE tripId = ? AND isArchived = 0;

selectTripParticipantById:
SELECT * FROM tripParticipant WHERE id = ?;

CREATE TABLE tripExpense (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    categoryId TEXT,
    subcategoryId TEXT,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    paidByParticipantId TEXT NOT NULL,
    occurredAt INTEGER NOT NULL,
    note TEXT NOT NULL
);

insertTripExpense:
INSERT INTO tripExpense (id, tripId, categoryId, subcategoryId, amountMinorUnits, currency, paidByParticipantId, occurredAt, note)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTripExpenses:
SELECT * FROM tripExpense WHERE tripId = ? ORDER BY occurredAt DESC;

selectTripExpenseById:
SELECT * FROM tripExpense WHERE id = ?;

updateTripExpense:
UPDATE tripExpense SET categoryId = ?, subcategoryId = ?, amountMinorUnits = ?, currency = ?, paidByParticipantId = ?, occurredAt = ?, note = ? WHERE id = ?;

deleteTripExpense:
DELETE FROM tripExpense WHERE id = ?;

CREATE TABLE expenseSplit (
    id TEXT NOT NULL PRIMARY KEY,
    tripExpenseId TEXT NOT NULL,
    participantId TEXT NOT NULL,
    shareAmountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertExpenseSplit:
INSERT INTO expenseSplit (id, tripExpenseId, participantId, shareAmountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectExpenseSplits:
SELECT * FROM expenseSplit WHERE tripExpenseId = ?;

deleteExpenseSplitsForExpense:
DELETE FROM expenseSplit WHERE tripExpenseId = ?;

CREATE TABLE tripExpenseContribution (
    id TEXT NOT NULL PRIMARY KEY,
    tripExpenseId TEXT NOT NULL,
    participantId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertTripExpenseContribution:
INSERT INTO tripExpenseContribution (id, tripExpenseId, participantId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectTripExpenseContributions:
SELECT * FROM tripExpenseContribution WHERE tripExpenseId = ?;

deleteTripExpenseContributionsForExpense:
DELETE FROM tripExpenseContribution WHERE tripExpenseId = ?;

CREATE TABLE settlement (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    fromParticipantId TEXT NOT NULL,
    toParticipantId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    settledAt INTEGER NOT NULL,
    note TEXT NOT NULL
);

insertSettlement:
INSERT INTO settlement (id, tripId, fromParticipantId, toParticipantId, amountMinorUnits, currency, settledAt, note)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectSettlements:
SELECT * FROM settlement WHERE tripId = ?;

CREATE TABLE householdSettlement (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    fromMemberId TEXT NOT NULL,
    toMemberId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    settledAt INTEGER NOT NULL,
    note TEXT NOT NULL
);

insertHouseholdSettlement:
INSERT INTO householdSettlement (id, householdId, fromMemberId, toMemberId, amountMinorUnits, currency, settledAt, note)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholdSettlements:
SELECT * FROM householdSettlement WHERE householdId = ?;

CREATE TABLE device (
    deviceId TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    ownerMemberId TEXT NOT NULL,
    lastSeenHlcPhysical INTEGER,
    lastSeenHlcCounter INTEGER,
    publicKey TEXT NOT NULL
);

selectDevices:
SELECT * FROM device;

-- A phone that scanned the "Add Android Device" QR (device-level pairing,
-- not tied to any specific household/activity — see JoinInvite.kt
-- kind="server"). Separate from `device` above, which is for the real
-- per-household crypto handshake in Core/sync/Pairing.kt and isn't wired
-- up yet; this is the simpler placeholder pairing that IS wired up.
-- pairingKey is a server-issued token, re-minted every time this device
-- pairs (or re-pairs). Heartbeats must present the current key; removing
-- the row (or re-pairing, which mints a new key) makes any previously
-- issued key invalid, so a removed/revoked device can't silently keep
-- syncing just because it still remembers its old deviceId.
CREATE TABLE pairedDevice (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    pairingKey TEXT NOT NULL,
    pairedAt INTEGER NOT NULL,
    lastSeenAt INTEGER NOT NULL
);

upsertPairedDevice:
INSERT OR REPLACE INTO pairedDevice (id, label, pairingKey, pairedAt, lastSeenAt) VALUES (?, ?, ?, ?, ?);

selectPairedDevices:
SELECT * FROM pairedDevice ORDER BY pairedAt;

selectPairedDeviceById:
SELECT * FROM pairedDevice WHERE id = ?;

deletePairedDevice:
DELETE FROM pairedDevice WHERE id = ?;
