insertExpenseSplit:
INSERT OR REPLACE INTO expenseSplit (id, tripExpenseId, participantId, shareAmountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectExpenseSplits:
SELECT * FROM expenseSplit WHERE tripExpenseId = ?;

deleteExpenseSplitsForExpense:
DELETE FROM expenseSplit WHERE tripExpenseId = ?;

CREATE TABLE tripExpenseContribution (
    id TEXT NOT NULL PRIMARY KEY,
    tripExpenseId TEXT NOT NULL,
    participantId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertTripExpenseContribution:
INSERT OR REPLACE INTO tripExpenseContribution (id, tripExpenseId, participantId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectTripExpenseContributions:
SELECT * FROM tripExpenseContribution WHERE tripExpenseId = ?;

deleteTripExpenseContributionsForExpense:
DELETE FROM tripExpenseContribution WHERE tripExpenseId = ?;

CREATE TABLE settlement (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    fromParticipantId TEXT NOT NULL,
    toParticipantId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    settledAt INTEGER NOT NULL,
    note TEXT NOT NULL,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertSettlement:
INSERT OR REPLACE INTO settlement (id, tripId, fromParticipantId, toParticipantId, amountMinorUnits, currency, settledAt, note, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSettlements:
SELECT * FROM settlement WHERE tripId = ? AND isDeleted = 0;

settlementStamp:
SELECT updatedAt FROM settlement WHERE id = ?;

settlementsChanged:
SELECT * FROM settlement WHERE tripId = ? AND serverSeq > ?;

CREATE TABLE householdSettlement (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    fromMemberId TEXT NOT NULL,
    toMemberId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    settledAt INTEGER NOT NULL,
    note TEXT NOT NULL,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertHouseholdSettlement:
INSERT OR REPLACE INTO householdSettlement (id, householdId, fromMemberId, toMemberId, amountMinorUnits, currency, settledAt, note, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholdSettlements:
SELECT * FROM householdSettlement WHERE householdId = ? AND isDeleted = 0;

householdSettlementStamp:
SELECT updatedAt FROM householdSettlement WHERE id = ?;

householdSettlementsChanged:
SELECT * FROM householdSettlement WHERE householdId = ? AND serverSeq > ?;

-- Highest write sequence number so far; the server continues from here after a restart.
maxServerSeq:
SELECT MAX(serverSeq) AS maxSeq FROM (
    SELECT serverSeq FROM household UNION ALL SELECT serverSeq FROM category UNION ALL
    SELECT serverSeq FROM subcategory UNION ALL SELECT serverSeq FROM member UNION ALL
    SELECT serverSeq FROM householdDependent UNION ALL SELECT serverSeq FROM monthlyBudget UNION ALL
    SELECT serverSeq FROM householdExpense UNION ALL SELECT serverSeq FROM householdSettlement UNION ALL
    SELECT serverSeq FROM trip UNION ALL SELECT serverSeq FROM tripParticipant UNION ALL
    SELECT serverSeq FROM tripExpense UNION ALL SELECT serverSeq FROM settlement
);

CREATE TABLE device (
    deviceId TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    ownerMemberId TEXT NOT NULL,
    lastSeenHlcPhysical INTEGER,
    lastSeenHlcCounter INTEGER,
    publicKey TEXT NOT NULL
);

selectDevices:
SELECT * FROM device;

-- A phone that scanned the "Add Android Device" QR (device-level pairing,
-- not tied to any specific household/activity — see JoinInvite.kt
-- kind="server"). Separate from `device` above, which is for the real
-- per-household crypto handshake in Core/sync/Pairing.kt and isn't wired
-- up yet; this is the simpler placeholder pairing that IS wired up.
-- pairingKey is a server-issued token, re-minted every time this device
-- pairs (or re-pairs). Heartbeats must present the current key; removing
-- the row (or re-pairing, which mints a new key) makes any previously
-- issued key invalid, so a removed/revoked device can't silently keep
-- syncing just because it still remembers its old deviceId.
CREATE TABLE pairedDevice (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    pairingKey TEXT NOT NULL,
    pairedAt INTEGER NOT NULL,
    lastSeenAt INTEGER NOT NULL
);

upsertPairedDevice:
INSERT OR REPLACE INTO pairedDevice (id, label, pairingKey, pairedAt, lastSeenAt) VALUES (?, ?, ?, ?, ?);

selectPairedDevices:
SELECT * FROM pairedDevice ORDER BY pairedAt;

selectPairedDeviceById:
SELECT * FROM pairedDevice WHERE id = ?;

deletePairedDevice:
DELETE FROM pairedDevice WHERE id = ?;
