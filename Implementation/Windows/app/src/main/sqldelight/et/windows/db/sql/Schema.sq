upsertTripExpense:
INSERT OR REPLACE INTO tripExpense (id, tripId, categoryId, subcategoryId, amountMinorUnits, currency, paidByParticipantId, occurredAt, note, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTripExpenses:
SELECT * FROM tripExpense WHERE tripId = ? AND isDeleted = 0 ORDER BY occurredAt DESC;

selectTripExpenseById:
SELECT * FROM tripExpense WHERE id = ? AND isDeleted = 0;

tripExpenseRowById:
SELECT * FROM tripExpense WHERE id = ?;

tripExpenseStamp:
SELECT updatedAt FROM tripExpense WHERE id = ?;

tripExpensesChanged:
SELECT * FROM tripExpense WHERE tripId = ? AND serverSeq > ?;

