    budgetAmountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    createdBy TEXT NOT NULL,
    isClosed INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertTrip:
INSERT OR REPLACE INTO trip (id, name, startDate, endDate, budgetAmountMinorUnits, currency, createdBy, isClosed, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTrips:
SELECT * FROM trip WHERE isDeleted = 0 ORDER BY startDate DESC;

selectTrip:
SELECT * FROM trip WHERE id = ? AND isDeleted = 0;

tripStamp:
SELECT updatedAt FROM trip WHERE id = ?;

tripChanged:
SELECT * FROM trip WHERE id = ? AND serverSeq > ?;

