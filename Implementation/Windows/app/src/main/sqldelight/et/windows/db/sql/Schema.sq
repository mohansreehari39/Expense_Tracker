-- The operation log below is written but not transmitted; real sync uses
-- the per-record stamps on the materialized tables (see their header).

CREATE TABLE operationLog (
    opId TEXT NOT NULL PRIMARY KEY,
    entityType TEXT NOT NULL,
    entityId TEXT NOT NULL,
    opType TEXT NOT NULL,
    patchJson TEXT NOT NULL,
    authorDeviceId TEXT NOT NULL,
    hlcPhysical INTEGER NOT NULL,
    hlcCounter INTEGER NOT NULL,
    receivedFrom TEXT
);

CREATE INDEX operationLog_frontier ON operationLog(authorDeviceId, hlcPhysical, hlcCounter);

insertOperation:
INSERT OR IGNORE INTO operationLog (opId, entityType, entityId, opType, patchJson, authorDeviceId, hlcPhysical, hlcCounter, receivedFrom)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

allOperations:
SELECT * FROM operationLog;

-- Materialized tables --------------------------------------------------
--
-- Every synced table carries the same three sync columns:
--   updatedAt  encoded Hlc stamp of the last change (et.core.model.encode);
--              '' for rows written before stamps existed (= oldest).
--              Last write wins: an incoming record replaces a row only if
--              its stamp is later (et.core.api.Lww).
--   isDeleted  1 = tombstone. Kept so a device that missed the delete
--              can't bring the row back; the app's read queries skip it.
--   serverSeq  this server's write sequence number, bumped on every write.
--              Pulls ask for "serverSeq > my cursor", so even a late push
--              of an old edit is still delivered to everyone else.
-- Ids are generated by whichever device created the record and are the
-- same everywhere, so pushing the same record twice is harmless.

CREATE TABLE household (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    defaultBudgetAmountMinorUnits INTEGER,
    defaultBudgetCurrency TEXT,
    settlementEnabled INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertHousehold:
INSERT OR REPLACE INTO household (id, name, createdAt, defaultBudgetAmountMinorUnits, defaultBudgetCurrency, settlementEnabled, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholds:
SELECT * FROM household WHERE isDeleted = 0 ORDER BY createdAt;

selectHouseholdById:
SELECT * FROM household WHERE id = ? AND isDeleted = 0;

householdStamp:
SELECT updatedAt FROM household WHERE id = ?;

householdChanged:
SELECT * FROM household WHERE id = ? AND serverSeq > ?;

CREATE TABLE category (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertCategory:
INSERT OR REPLACE INTO category (id, householdId, name, icon, isArchived, updatedAt, isDeleted, serverSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectCategories:
SELECT * FROM category WHERE householdId = ? AND isArchived = 0 AND isDeleted = 0;

selectCategoryById:
SELECT * FROM category WHERE id = ? AND isDeleted = 0;

categoryStamp:
SELECT updatedAt FROM category WHERE id = ?;

categoriesChanged:
SELECT * FROM category WHERE householdId = ? AND serverSeq > ?;

CREATE TABLE subcategory (
    id TEXT NOT NULL PRIMARY KEY,
    categoryId TEXT NOT NULL,
    name TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertSubcategory:
INSERT OR REPLACE INTO subcategory (id, categoryId, name, isArchived, updatedAt, isDeleted, serverSeq) VALUES (?, ?, ?, ?, ?, ?, ?);

selectSubcategories:
SELECT * FROM subcategory WHERE categoryId = ? AND isArchived = 0 AND isDeleted = 0;

selectSubcategoryById:
SELECT * FROM subcategory WHERE id = ? AND isDeleted = 0;

subcategoryStamp:
SELECT updatedAt FROM subcategory WHERE id = ?;

subcategoriesChanged:
SELECT subcategory.* FROM subcategory JOIN category ON subcategory.categoryId = category.id
WHERE category.householdId = ? AND subcategory.serverSeq > ?;

CREATE TABLE member (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    displayName TEXT NOT NULL,
    deviceId TEXT,
    email TEXT,
    phone TEXT,
    isArchived INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertMember:
INSERT OR REPLACE INTO member (id, householdId, displayName, deviceId, email, phone, isArchived, updatedAt, isDeleted, serverSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMembers:
SELECT * FROM member WHERE householdId = ? AND isArchived = 0 AND isDeleted = 0;

selectMemberById:
SELECT * FROM member WHERE id = ?;

selectMemberByDisplayName:
SELECT * FROM member WHERE householdId = ? AND displayName = ? COLLATE NOCASE AND isDeleted = 0 LIMIT 1;

selectMemberByDeviceId:
SELECT * FROM member WHERE householdId = ? AND deviceId = ? AND isDeleted = 0 LIMIT 1;

memberStamp:
SELECT updatedAt FROM member WHERE id = ?;

membersChanged:
SELECT * FROM member WHERE householdId = ? AND serverSeq > ?;

CREATE TABLE householdDependent (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

upsertHouseholdDependent:
INSERT OR REPLACE INTO householdDependent (id, householdId, name, category, isArchived, updatedAt, isDeleted, serverSeq) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholdDependents:
SELECT * FROM householdDependent WHERE householdId = ? AND isArchived = 0 AND isDeleted = 0;

selectHouseholdDependentById:
SELECT * FROM householdDependent WHERE id = ?;

householdDependentStamp:
SELECT updatedAt FROM householdDependent WHERE id = ?;

householdDependentsChanged:
SELECT * FROM householdDependent WHERE householdId = ? AND serverSeq > ?;

CREATE TABLE monthlyBudget (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    year INTEGER NOT NULL,
    month INTEGER NOT NULL,
    totalAmountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    perCategoryJson TEXT NOT NULL,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0,
    UNIQUE(householdId, year, month)
);

upsertMonthlyBudget:
INSERT OR REPLACE INTO monthlyBudget (id, householdId, year, month, totalAmountMinorUnits, currency, perCategoryJson, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMonthlyBudget:
SELECT * FROM monthlyBudget WHERE householdId = ? AND year = ? AND month = ? AND isDeleted = 0;

monthlyBudgetStamp:
SELECT updatedAt FROM monthlyBudget WHERE id = ?;

monthlyBudgetsChanged:
SELECT * FROM monthlyBudget WHERE householdId = ? AND serverSeq > ?;

CREATE TABLE householdExpense (
    id TEXT NOT NULL PRIMARY KEY,
    householdId TEXT NOT NULL,
    categoryId TEXT NOT NULL,
    subcategoryId TEXT,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL,
    paidByMemberId TEXT NOT NULL,
    occurredAt INTEGER NOT NULL,
    note TEXT NOT NULL,
    createdByDeviceId TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt TEXT NOT NULL DEFAULT '',
    isDeleted INTEGER NOT NULL DEFAULT 0,
    serverSeq INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX householdExpense_occurredAt ON householdExpense(householdId, occurredAt);

upsertHouseholdExpense:
INSERT OR REPLACE INTO householdExpense (id, householdId, categoryId, subcategoryId, amountMinorUnits, currency, paidByMemberId, occurredAt, note, createdByDeviceId, createdAt, updatedAt, isDeleted, serverSeq)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHouseholdExpensesBetween:
SELECT * FROM householdExpense WHERE householdId = ? AND occurredAt >= ? AND occurredAt < ? AND isDeleted = 0 ORDER BY occurredAt DESC;

selectHouseholdExpenseById:
SELECT * FROM householdExpense WHERE id = ? AND isDeleted = 0;

householdExpenseRowById:
SELECT * FROM householdExpense WHERE id = ?;

householdExpenseStamp:
SELECT updatedAt FROM householdExpense WHERE id = ?;

householdExpensesChanged:
SELECT * FROM householdExpense WHERE householdId = ? AND serverSeq > ?;

CREATE TABLE householdExpenseBeneficiary (
    id TEXT NOT NULL PRIMARY KEY,
    householdExpenseId TEXT NOT NULL,
    memberId TEXT,
    dependentId TEXT,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertHouseholdExpenseBeneficiary:
INSERT OR REPLACE INTO householdExpenseBeneficiary (id, householdExpenseId, memberId, dependentId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?, ?);

selectHouseholdExpenseBeneficiaries:
SELECT * FROM householdExpenseBeneficiary WHERE householdExpenseId = ?;

deleteHouseholdExpenseBeneficiariesForExpense:
DELETE FROM householdExpenseBeneficiary WHERE householdExpenseId = ?;

CREATE TABLE householdExpenseContribution (
    id TEXT NOT NULL PRIMARY KEY,
    householdExpenseId TEXT NOT NULL,
    memberId TEXT NOT NULL,
    amountMinorUnits INTEGER NOT NULL,
    currency TEXT NOT NULL
);

insertHouseholdExpenseContribution:
INSERT OR REPLACE INTO householdExpenseContribution (id, householdExpenseId, memberId, amountMinorUnits, currency)
VALUES (?, ?, ?, ?, ?);

selectHouseholdExpenseContributions:
SELECT * FROM householdExpenseContribution WHERE householdExpenseId = ?;

deleteHouseholdExpenseContributionsForExpense:
DELETE FROM householdExpenseContribution WHERE householdExpenseId = ?;

